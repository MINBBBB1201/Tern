# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Duffel flight search API (get from https://app.duffel.com)
DUFFEL_ACCESS_TOKEN=

# Travelpayouts / Aviasales affiliate link IDs (not secrets — visible in the
# final URL). NEXT_PUBLIC_ because links are built client-side.
NEXT_PUBLIC_TRAVELPAYOUTS_CAMPAIGN_ID=
NEXT_PUBLIC_TRAVELPAYOUTS_MARKER=
NEXT_PUBLIC_TRAVELPAYOUTS_P=
NEXT_PUBLIC_TRAVELPAYOUTS_TRS=

# Firebase Auth config (client-side keys, safe to expose publicly —
# access is controlled by Firebase security rules, not by hiding this key)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# OpenWeather API (get from https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# LocationIQ geocoding API (get from https://locationiq.com)
LOCATIONIQ_API_KEY=

# Throwaway Firebase Auth test account used by scripts/i3-*.mjs screenshot
# scripts. Never reuse a real account's credentials here.
TERN_TEST_EMAIL=
TERN_TEST_PASSWORD=
